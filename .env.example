# Copier ce fichier en .env.local (jamais commité) et renseigner les valeurs.

# Base PostgreSQL Supabase — chaîne de connexion « Transaction pooler » (port 6543),
# disponible dans Supabase > Project Settings > Database > Connection string.
# Créer le projet en région UE (ex. eu-west-3 Paris) : stockage des données de santé
# dans l'UE/EEE uniquement (CSP R1111-9-1).
# ⚠ Supabase n'est pas un hébergeur certifié HDS : données FICTIVES uniquement.
# Sans cette variable, l'application utilise une base PostgreSQL embarquée (PGlite).
DATABASE_URL=

# Clé de signature des sessions (chaîne aléatoire d'au moins 32 caractères).
SESSION_SECRET=
